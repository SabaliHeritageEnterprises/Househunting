# Copy this file to .env and adjust as needed.

PORT=4000

# Secret used to sign JWTs. Change this to a long random string in production.
JWT_SECRET=sabali-dev-secret-change-me

# Optional: set to "true" to route /api/generate-image at OpenAI's image API
# instead of the built-in mock generator. Requires OPENAI_API_KEY.
USE_OPENAI_IMAGES=false
OPENAI_API_KEY=
